{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/course-registration/1.0/register.schema.json",
  "title": "Course registration cart, as a DIDComm v2 plaintext message",
  "description": "See README.md. $defs/envelope is Tier 1 (syntactic); $defs/register is Tier 2 (schema).",
  "allOf": [
    {
      "$ref": "#/$defs/envelope"
    },
    {
      "$ref": "#/$defs/register"
    }
  ],
  "$defs": {
    "envelope": {
      "description": "DIDComm v2 plaintext message headers. Unknown headers are allowed, as DIDComm requires.",
      "type": "object",
      "required": [
        "id",
        "type",
        "body"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "description": "Message type URI: <doc-uri><protocol-name>/<version>/<message-name>.",
          "type": "string",
          "pattern": "^(.*?)([a-z0-9._-]+)/(\\d[^/]*)/([a-z0-9._-]+)$"
        },
        "typ": {
          "const": "application/didcomm-plain+json"
        },
        "from": {
          "$ref": "#/$defs/did"
        },
        "to": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/did"
          }
        },
        "thid": {
          "type": "string",
          "minLength": 1
        },
        "pthid": {
          "type": "string",
          "minLength": 1
        },
        "created_time": {
          "description": "UTC epoch seconds.",
          "type": "integer",
          "minimum": 0
        },
        "expires_time": {
          "description": "UTC epoch seconds.",
          "type": "integer",
          "minimum": 0
        },
        "body": {
          "type": "object"
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attachment"
          }
        }
      }
    },
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:.+$"
    },
    "attachment": {
      "type": "object",
      "required": [
        "data"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "filename": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "lastmod_time": {
          "type": "integer",
          "minimum": 0
        },
        "byte_count": {
          "type": "integer",
          "minimum": 0
        },
        "data": {
          "type": "object",
          "anyOf": [
            {
              "required": [
                "base64"
              ]
            },
            {
              "required": [
                "json"
              ]
            },
            {
              "required": [
                "links"
              ]
            }
          ]
        }
      }
    },
    "register": {
      "description": "The one message type the registration system accepts.",
      "properties": {
        "type": {
          "const": "https://example.org/course-registration/1.0/register"
        },
        "body": {
          "$ref": "#/$defs/body"
        }
      }
    },
    "body": {
      "description": "A cart: every section one student registers for, in one term, in one request.",
      "type": "object",
      "required": [
        "student_id",
        "term_code",
        "sections"
      ],
      "additionalProperties": false,
      "properties": {
        "student_id": {
          "$ref": "#/$defs/identifier"
        },
        "term_code": {
          "description": "The term being registered for, e.g. 202640 (Fall 2026).",
          "type": "string",
          "pattern": "^\\d{6}$"
        },
        "sections": {
          "description": "At least one section; no crn twice (checked in didcomm_schema.py).",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/cart_item"
          }
        }
      }
    },
    "identifier": {
      "type": "string",
      "pattern": "^\\S+$"
    },
    "cart_item": {
      "description": "One section in the cart: its crn, the section's details copied from the input, and the credits taken. Tier 3 checks every copied field against the offered section.",
      "type": "object",
      "required": [
        "crn",
        "course_id",
        "section",
        "credit_hours",
        "seats_total",
        "seats_taken",
        "campus",
        "modality",
        "meetings"
      ],
      "additionalProperties": false,
      "properties": {
        "crn": {
          "$ref": "#/$defs/identifier"
        },
        "course_id": {
          "$ref": "#/$defs/course_id"
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "credit_hours": {
          "description": "Credits the student takes: the section's credits, or, for a variable-credit section, a number in its range.",
          "type": "number",
          "minimum": 0
        },
        "seats_total": {
          "type": "integer",
          "minimum": 0
        },
        "seats_taken": {
          "type": "integer",
          "minimum": 0
        },
        "campus": {
          "type": "string",
          "minLength": 1
        },
        "modality": {
          "enum": [
            "in-person",
            "online",
            "hybrid"
          ]
        },
        "meetings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/meeting"
          }
        },
        "waitlist": {
          "description": "true = join the waitlist, because the section is full. Default false.",
          "type": "boolean"
        }
      }
    },
    "course_id": {
      "description": "Subject code plus course number, no space, as in the input (e.g. CS04114).",
      "type": "string",
      "pattern": "^[A-Z]{2,4}[A-Z0-9]{5}$"
    },
    "clock_time": {
      "description": "h:mm AM/PM or hh:mm AM/PM, as the input writes it.",
      "type": "string",
      "pattern": "^(0?[1-9]|1[0-2]):[0-5]\\d (AM|PM)$"
    },
    "meeting": {
      "description": "One meeting of the section, copied from the input. A meeting with days but no times is time-to-be-arranged.",
      "type": "object",
      "required": [
        "days"
      ],
      "additionalProperties": false,
      "properties": {
        "days": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "Monday",
              "Tuesday",
              "Wednesday",
              "Thursday",
              "Friday",
              "Saturday",
              "Sunday"
            ]
          }
        },
        "start_time": {
          "$ref": "#/$defs/clock_time"
        },
        "end_time": {
          "$ref": "#/$defs/clock_time"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        }
      },
      "dependentRequired": {
        "start_time": [
          "end_time"
        ],
        "end_time": [
          "start_time"
        ]
      }
    }
  }
}
