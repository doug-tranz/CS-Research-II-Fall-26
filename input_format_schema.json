{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.edu/registration/input-format/0.3/schema.json",
  "title": "Registration Input Format (draft)",
  
  "type": "object",
  "required": ["student", "transcript", "program_requirements", "schedule", "prompt"],
  "properties": {
    "student": { "$ref": "#/$defs/student" },
    "transcript": { "$ref": "#/$defs/transcript" },
    "program_requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/requirement" }
    },
    "schedule": { "$ref": "#/$defs/schedule" },
    "prompt": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false,

  "$defs": {

    "courseId": {
      "type": "string",
      "pattern": "^[A-Z]{2,4}[A-Z0-9]{5}$",
      "description": "Subject code + course number, no space, e.g. CS04113 or PHYSL0220. Always a string."
    },
    "term": {
      "type": "string",
      "pattern": "^(Spring|Summer|Fall|Winter) [0-9]{4}$",
      "description": "Season YYYY, e.g. Fall 2026. Season list is an assumption; the spec only says 'Season YYYY'."
    },
    "creditHours": {
      "type": "number",
      "minimum": 0,
      "description": "A JSON number (4), never a string (\"4.000\")."
    },
    "grade": {
      "enum": ["A", "A-", "B+", "B", "B-", "C+", "C", "C-", "D+", "D", "D-", "F", "W", "TA"]
    },
    "letterGrade": {
      "description": "Passing letter grades only, used for minimum_grade.",
      "enum": ["A", "A-", "B+", "B", "B-", "C+", "C", "C-", "D+", "D", "D-"]
    },
    "level": { "enum": ["UG", "GR"] },
    "clockTime": {
      "type": "string",
      "pattern": "^(1[0-2]|[1-9]):[0-5][0-9] (AM|PM)$",
      "description": "h:mm AM/PM, e.g. 10:00 AM"
    },
    "dayName": {
      "enum": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
    },

    "student": {
      "type": "object",
      "required": ["student_id", "degree", "major", "program_id", "catalog_year"],
      "properties": {
        "student_id": { "type": "string", "minLength": 1 },
        "degree": { "type": "string", "minLength": 1 },
        "major": { "type": "string", "minLength": 1 },
        "minor": { "type": "string" },
        "program_id": { "type": "string", "minLength": 1 },
        "catalog_year": { "$ref": "#/$defs/term" }
      },
      "additionalProperties": false
    },

    "transcript": {
      "type": "object",
      "required": ["completed_courses", "transfer_courses", "courses_in_progress"],
      "properties": {
        "completed_courses": { "type": "array", "items": { "$ref": "#/$defs/completedCourse" } },
        "transfer_courses": { "type": "array", "items": { "$ref": "#/$defs/transferCourse" } },
        "courses_in_progress": { "type": "array", "items": { "$ref": "#/$defs/inProgressCourse" } }
      },
      "additionalProperties": false
    },

    "completedCourse": {
      "type": "object",
      "required": ["term", "course_id", "grade", "credit_hours"],
      "properties": {
        "term": { "$ref": "#/$defs/term" },
        "course_id": { "$ref": "#/$defs/courseId" },
        "campus": { "type": "string" },
        "level": { "$ref": "#/$defs/level" },
        "title": { "type": "string" },
        "grade": { "$ref": "#/$defs/grade" },
        "credit_hours": { "$ref": "#/$defs/creditHours" }
      },
      "additionalProperties": false
    },

    "transferCourse": {
      "type": "object",
      "required": ["institution", "course_id", "grade", "credit_hours"],
      "properties": {
        "institution": { "type": "string", "minLength": 1 },
        "course_id": { "$ref": "#/$defs/courseId" },
        "title": { "type": "string" },
        "grade": { "$ref": "#/$defs/grade" },
        "credit_hours": { "$ref": "#/$defs/creditHours" }
      },
      "additionalProperties": false
    },

    "inProgressCourse": {
      "description": "No grade field: any grade here is rejected as an extra property.",
      "type": "object",
      "required": ["term", "course_id", "credit_hours"],
      "properties": {
        "term": { "$ref": "#/$defs/term" },
        "course_id": { "$ref": "#/$defs/courseId" },
        "campus": { "type": "string" },
        "level": { "$ref": "#/$defs/level" },
        "title": { "type": "string" },
        "credit_hours": { "$ref": "#/$defs/creditHours" }
      },
      "additionalProperties": false
    },

    "requirement": {
      "type": "object",
      "required": ["req_id", "category", "rule", "course_options", "credit_hours", "minimum_grade"],
      "properties": {
        "req_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "rule": { "enum": ["all_of", "any_of", "credits_from"] },
        "course_options": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/courseId" }
        },
        "title": { "type": "string" },
        "credit_hours": { "$ref": "#/$defs/creditHours" },
        "minimum_grade": { "$ref": "#/$defs/letterGrade" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },

    "schedule": {
      "type": "object",
      "required": ["term", "sections"],
      "properties": {
        "term": { "$ref": "#/$defs/term" },
        "sections": { "type": "array", "items": { "$ref": "#/$defs/section" } }
      },
      "additionalProperties": false
    },

    "section": {
      "type": "object",
      "required": [
        "crn", "course_id", "section", "credit_hours",
        "seats_total", "seats_taken", "campus", "modality", "meetings"
      ],
      "properties": {
        "crn": { "type": "string", "minLength": 1 },
        "course_id": { "$ref": "#/$defs/courseId" },
        "section": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "credit_hours": { "$ref": "#/$defs/creditHours" },
        "seats_total": { "type": "integer", "minimum": 0 },
        "seats_taken": { "type": "integer", "minimum": 0 },
        "campus": { "type": "string", "minLength": 1 },
        "modality": { "enum": ["in-person", "online", "hybrid"] },
        "meetings": { "type": "array", "items": { "$ref": "#/$defs/meeting" } }
      },
      "additionalProperties": false
    },

    "meeting": {
      "type": "object",
      "required": ["days", "start_time", "end_time"],
      "properties": {
        "days": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/dayName" }
        },
        "start_time": { "$ref": "#/$defs/clockTime" },
        "end_time": { "$ref": "#/$defs/clockTime" },
        "type": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
