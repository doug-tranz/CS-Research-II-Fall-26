{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/course-registration/1.0/register.schema.json",
  "title": "Course registration cart, as a DIDComm v2 plaintext message",
  "description": "See README.md. $defs/envelope is Tier 1 (syntactic); $defs/register is Tier 2 (schema).",
  "allOf": [
    { "$ref": "#/$defs/envelope" },
    { "$ref": "#/$defs/register" }
  ],
  "$defs": {
    "envelope": {
      "description": "DIDComm v2 plaintext message headers. Unknown headers are allowed, as DIDComm requires.",
      "type": "object",
      "required": ["id", "type", "body"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "description": "Message type URI: <doc-uri><protocol-name>/<version>/<message-name>.",
          "type": "string",
          "pattern": "^(.*?)([a-z0-9._-]+)/(\\d[^/]*)/([a-z0-9._-]+)$"
        },
        "typ": { "const": "application/didcomm-plain+json" },
        "from": { "$ref": "#/$defs/did" },
        "to": { "type": "array", "items": { "$ref": "#/$defs/did" } },
        "thid": { "type": "string", "minLength": 1 },
        "pthid": { "type": "string", "minLength": 1 },
        "created_time": { "description": "UTC epoch seconds.", "type": "integer", "minimum": 0 },
        "expires_time": { "description": "UTC epoch seconds.", "type": "integer", "minimum": 0 },
        "body": { "type": "object" },
        "attachments": { "type": "array", "items": { "$ref": "#/$defs/attachment" } }
      }
    },
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:.+$"
    },
    "attachment": {
      "type": "object",
      "required": ["data"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "filename": { "type": "string" },
        "media_type": { "type": "string" },
        "format": { "type": "string" },
        "lastmod_time": { "type": "integer", "minimum": 0 },
        "byte_count": { "type": "integer", "minimum": 0 },
        "data": {
          "type": "object",
          "anyOf": [
            { "required": ["base64"] },
            { "required": ["json"] },
            { "required": ["links"] }
          ]
        }
      }
    },
    "register": {
      "description": "The one message type the registration system accepts.",
      "properties": {
        "type": { "const": "https://example.org/course-registration/1.0/register" },
        "body": { "$ref": "#/$defs/body" }
      }
    },
    "body": {
      "description": "A cart: every section one student registers for in one request.",
      "type": "object",
      "required": ["student_id", "sections"],
      "additionalProperties": false,
      "properties": {
        "student_id": { "$ref": "#/$defs/identifier" },
        "sections": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "identifier": {
      "type": "string",
      "pattern": "^\\S+$"
    }
  }
}
